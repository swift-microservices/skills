# Release image for one Swift service: `serve` and `worker run` are commands of this one image.
# Replace example-service with the executable product. Pin base images by digest where the
# project's policy requires it; keep the toolchain tag equal to CI's.

# ================================
# Build stage
# ================================
FROM swift:6.3-noble AS build

RUN export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true \
    && apt-get -q update \
    && apt-get -q dist-upgrade -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Resolve the committed graph in its own layer: it caches while the manifests are unchanged, and a
# stale Package.resolved fails here instead of being updated.
COPY ./Package.* ./
RUN swift package --disable-automatic-resolution resolve

COPY . .

RUN swift build \
    --configuration release \
    --disable-automatic-resolution \
    --static-swift-stdlib \
    --explicit-target-dependency-import-check error \
    -Xswiftc -warnings-as-errors \
    -Xswiftc -require-explicit-sendable \
    --product example-service

# Stage the executable, the backtracer, and every resource bundle; copying only the binary drops
# the bundles silently.
WORKDIR /staging
RUN bin="$(swift build --package-path /build --configuration release --show-bin-path)" \
    && cp "$bin/example-service" ./ \
    && cp /usr/libexec/swift/linux/swift-backtrace-static ./ \
    && find -L "$bin/" -regex '.*\.resources$' -exec cp -Ra {} ./ \;

# ================================
# Runtime stage
# ================================
FROM ubuntu:noble

# Fixed numeric IDs. The certificate renewers write as RENEWER_UID with this APP_GID, so the
# process can read its credential directory and cannot write it (see certificates.md).
ARG APP_UID=10001
ARG APP_GID=10001

RUN export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true \
    && apt-get -q update \
    && apt-get -q dist-upgrade -y \
    && apt-get -q install -y --no-install-recommends \
        ca-certificates \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid "${APP_GID}" app \
    && useradd --system --uid "${APP_UID}" --gid app \
        --home-dir /app --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

# Root-owned and read-only to the process: it cannot replace its own executable.
COPY --from=build /staging /app

ENV SWIFT_BACKTRACE=enable=yes,sanitize=yes,threads=all,images=all,interactive=no,swift-backtrace=/app/swift-backtrace-static

USER ${APP_UID}:${APP_GID}

ENTRYPOINT ["/app/example-service"]
CMD ["serve"]
