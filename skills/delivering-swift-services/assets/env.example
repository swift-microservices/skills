# Copy to .env.example in the stack's root; each environment copies it to a git-ignored .env and
# fills every empty value. Compose refuses to start while a required value is missing.
# Database passwords are the one secret that stays a variable; key material is a file path.

COMPOSE_FILE=compose.yaml:ca-compose.yaml

# Images: published tags only, a short SHA to pin or a branch tag to follow
REGISTRY=ghcr.io/<organization>
<SERVICE>_IMAGE_TAG=
API_IMAGE_TAG=

# <service>'s database: the owner migrates; each role password is distinct
<SERVICE>_OWNER=
<SERVICE>_OWNER_PASSWORD=
<SERVICE>_SERVICE_ROLE=<service>_service
<SERVICE>_SERVICE_PASSWORD=
<SERVICE>_INTERNAL_ROLE=<service>_internal
<SERVICE>_INTERNAL_PASSWORD=
<SERVICE>_WORKER_ROLE=<service>_worker
<SERVICE>_WORKER_PASSWORD=
<SERVICE>_WORKER_STOP_GRACE_PERIOD=

# Temporal
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=

# Key material: paths to files outside the repository, never the keys themselves
JWT_KEY_DIRECTORY=./secrets/jwt
CA_PASSWORD_FILE=./secrets/ca/intermediate-password
CA_ROOT_FILE=./secrets/ca/root_ca.crt
CA_PKI_VOLUME=
ENROLLMENT_TOKEN_DIRECTORY=./secrets/enrollment

# Certificate machinery: APP_GID matches the Containerfile's; the renewer is another user in it
APP_GID=10001
RENEWER_UID=10002
CA_UID=1000
RENEW_BEFORE=
RENEW_CHECK_INTERVAL_SECONDS=

# The edge proxy's origin certificate pair (origin.pem, origin-key.pem), outside the repository
ORIGIN_CERTIFICATE_DIRECTORY=./secrets/origin

# Only with the tailnet sidecar alternative: first registration
# TS_AUTHKEY=
